{
  "name": "vydia-onboarding",
  "version": "0.1.0",
  "private": true,
  "description": "Vydia Onboarding",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:types": "supabase gen types typescript --local > lib/supabase/database.types.ts && prettier --write lib/supabase/database.types.ts",
    "db:test": "supabase test db",
    "storage:sweep": "tsx --env-file=.env.local scripts/storage-sweep.ts",
    "e2e": "playwright test",
    "e2e:setup": "tsx --env-file-if-exists=.env.local scripts/e2e-fixtures.ts",
    "e2e:teardown": "tsx --env-file-if-exists=.env.local scripts/e2e-fixtures.ts teardown",
    "email:preview": "tsx --env-file-if-exists=.env.local scripts/preview-email.ts",
    "brand:assets": "tsx scripts/export-brand-assets.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.1.0",
    "lucide-react": "1.72.0",
    "next": "16.4.6",
    "pdfjs-dist": "6.5.438",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "prettier": "3.10.1",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.8"
    }
  }
}
